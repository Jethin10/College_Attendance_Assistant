{
  "manifest_version": 3,
  "name": "NIET Attendance Planner",
  "version": "1.0.0",
  "description": "Auto-detects your NIET ERP attendance and tells you if it is safe to take leave. See bunkable classes, safe leave days, and simulate leave impact without leaving the ERP page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["*://nietcloud.niet.co.in/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://nietcloud.niet.co.in/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "NIET Attendance Planner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
